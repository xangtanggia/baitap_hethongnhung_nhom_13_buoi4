"bai4\stm32f1xx_hal_dma.o"
"bai4\stm32f1xx_hal_cortex.o"
"bai4\stm32f1xx_hal_pwr.o"
"bai4\stm32f1xx_hal_flash.o"
"bai4\stm32f1xx_hal_flash_ex.o"
